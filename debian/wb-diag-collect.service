[Unit]
Description=one-click diagnostic data collector for Wiren Board, generating archive with data
After=wb-hwconf-manager.service mosquitto.service

[Service]
Type=simple
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=2 6
SuccessExitStatus=7
User=root
ExecStart=/usr/bin/wb-diag-collect

[Install]
WantedBy=multi-user.target
