{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Wiren Board diagnostic collection recipe",
  "type": "object",
  "properties": {
    "timeout": {
      "type": "integer",
      "minimum": 1
    },
    "mqtt": {
      "type": "object",
      "properties": {
        "broker": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(unix|mqtt-tcp|tcp|ws)://"
        }
      },
      "required": ["broker"],
      "additionalProperties": false
    },
    "journald_logs": {
      "type": "object",
      "properties": {
        "lines_number": {
          "type": "integer",
          "minimum": 0
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["lines_number", "names"],
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["filename", "command"],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "glob": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string"
          },
          "repl": {
            "type": "string"
          }
        },
        "required": ["glob", "pattern", "repl"],
        "additionalProperties": false
      }
    }
  },
  "required": ["timeout", "mqtt", "journald_logs", "commands", "files", "filters"],
  "additionalProperties": false
}
